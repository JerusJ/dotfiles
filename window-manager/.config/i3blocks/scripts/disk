#!/usr/bin/env bash
# Free space on the mount point given as $1 (default /).
set -euo pipefail

# shellcheck source=sparkline.sh
source "$(dirname "$(readlink -f "$0")")/sparkline.sh"

mount=${1:-/}
read -r avail pct size < <(df -h --output=avail,pcent,size "$mount" |
    awk 'NR == 2 { gsub(/%/, "", $2); print $1, $2, $3 }')

color="#b5bd68"
((pct >= 80)) && color="#e6c547"
((pct >= 90)) && color="#cc6666"

# The headline number is what is left rather than what is used, so it is
# labelled outright -- "243G" alone reads just as easily as either one.
printf '%s <span foreground="%s">%s free</span> <span foreground="#666666">of %s</span>\n' \
    "$(icon f0a0 '#81a2be')" "$color" "$avail" "$size"
